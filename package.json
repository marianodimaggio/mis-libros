    "@types/node": "22.15.30",
    "@types/papaparse": "5.3.16",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "fake-indexeddb": "6.0.1",
